# {{ ansible_managed }}
[Unit]
Description=Redis data node (port {{ redis_port }}, {{ redis_mode }})
Documentation=https://redis.io/docs/
After=network-online.target {{ __redis_thp_service }}.service
Wants=network-online.target

[Service]
Type=simple
User={{ redis_user }}
Group={{ redis_group }}
# Foreground process; SIGTERM makes redis save (if persistence is on) and exit.
ExecStart={{ __redis_server_bin }} {{ __redis_conf_file }} --daemonize no --supervised no
Restart=on-failure
RestartSec=3
# Loading/saving a large dataset can take a while.
TimeoutStartSec=300
TimeoutStopSec=300
LimitNOFILE={{ redis_limit_nofile }}
# redis rewrites its config (CONFIG REWRITE / sentinel) and writes data + logs
ReadWritePaths=-{{ redis_conf_dir }} -{{ redis_data_dir }} -{{ redis_log_dir }}
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
